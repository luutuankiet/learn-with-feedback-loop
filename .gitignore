# Personal letters / longer-form private writing (identity-anchor docs)
raw/letters/*
!raw/letters/.gitkeep

# Personal article archive / clipped reading
raw/medium/*
!raw/medium/.gitkeep

# Retired surfaces (v3 — 2026-05-15): wiki/, raw-sessions/, skills/
_archive/

# Reference repos for study
_ref/

# Per-user pointers to active rebuild tracks (host + paths — not part of the template)
skills/*/pilots.md

# The learner's actual profile — personal instance, never published. Only the template ships.
PROFILE.md
PROFILE-*.md
!PROFILE.template.md

# OS noise
.DS_Store

# Scratch and agent worktrees — local working state, never published
tmp/
.claude/worktrees/
