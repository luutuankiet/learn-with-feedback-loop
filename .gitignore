# Personal data — never publish
gsd-lite/

# gsd-lite scaffolder leftovers (this repo ships the learn skill only — install gsd-lite separately if you want it)
.claude/agents/gsd-lite.md
.claude/commands/gsd/

# Personal letters / longer-form private writing (identity-anchor docs)
raw/letters/*
!raw/letters/.gitkeep

# Personal article archive / clipped reading
raw/medium/*
!raw/medium/.gitkeep

# Retired surfaces (v3 — 2026-05-15): wiki/, raw-sessions/, skills/
_archive/

# Reference repos for study
_ref/

# Per-user pointers to active rebuild tracks. These now live in the learner's own
# record, not beside a skill — this rule is the backstop for the old habit.
skills/*/pilots.md

# The learner's actual record — personal instance, never published. It lives outside
# this repo entirely now; these are the backstop for a stray copy.
PROFILE.md
PROFILE-*.md

# OS noise
.DS_Store

# Scratch and agent worktrees — local working state, never published
tmp/
.claude/worktrees/
